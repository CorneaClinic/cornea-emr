# Copy values into GitHub Actions secrets (never commit real values).
# See docs/FRESH_CLOUDFLARE_STACK.md

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=f2c41820d69631f2365f03a76922e190

# Neon (or other) Postgres — empty database, migrations run on container boot
CF_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CF_JWT_SECRET=
CF_SECRETS_ENCRYPTION_KEY=

# R2 S3-compatible API token (scoped to cornea-emr-media)
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=

# First admin (optional — also used for ALLOW_PRODUCTION_SEED)
CF_SEED_ADMIN_EMAIL=admin@example.com
CF_SEED_ADMIN_PASSWORD=
